{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/cabinet/**",
              "components/content/**",
              "components/core/**",
              "components/forms/**",
              "ui_kits/cabinet/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Geologica|Golos Text|Unbounded|Onest))/i]",
        "message": "Font not provided by the design system. Available: Geologica, Golos Text, Unbounded, Onest."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|children|solid|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: status, children, solid."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:free|reserved|sold|neutral|accent)$/]",
        "message": "<Badge> status must be one of 'free' | 'reserved' | 'sold' | 'neutral' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconLeft|children|disabled|fullWidth|type|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconLeft, children, disabled, fullWidth, type, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|accent|outline|inverse|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'accent' | 'outline' | 'inverse' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Button> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FaqItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:question|answer|open|onToggle|key|ref|className|style|children)$/]",
        "message": "<FaqItem> doesn't accept that prop. Declared props: question, answer, open, onToggle."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|children|style|key|ref|className|style|children)$/]",
        "message": "<FeatureChip> doesn't accept that prop. Declared props: icon, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HouseCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|kind|specs|themes|image|imagePosition|featured|onRequest|key|ref|className|style|children)$/]",
        "message": "<HouseCard> doesn't accept that prop. Declared props: name, kind, specs, themes, image, imagePosition, featured, onRequest."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute[name.name='name'] > Literal[value!=/^(?:arrow|trend|terrain|blueprint|home|cycle|briefcase|team|flag|plus|minus|check|shield|receipt|lock|pin|key|file|calendar|chevron|chevronRight|mail|phone|ruler|grid|wallet|user|logout)$/]",
        "message": "<Icon> name must be one of 'arrow' | 'trend' | 'terrain' | 'blueprint' | 'home' | 'cycle' | 'briefcase' | 'team' | 'flag' | 'plus' | 'minus' | 'check' | 'shield' | 'receipt' | 'lock' | 'pin' | 'key' | 'file' | 'calendar' | 'chevron' | 'chevronRight' | 'mail' | 'phone' | 'ruler' | 'grid' | 'wallet' | 'user' | 'logout'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|placeholder|type|tone|name|value|onChange|hint|error|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, placeholder, type, tone, name, value, onChange, hint, error."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<Input> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|mark|tone|size|ring|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: variant, mark, tone, size, ring."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:full|lockup|mark|wordmark)$/]",
        "message": "<Logo> variant must be one of 'full' | 'lockup' | 'mark' | 'wordmark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='mark'] > Literal[value!=/^(?:seal|cross|arch)$/]",
        "message": "<Logo> mark must be one of 'seal' | 'cross' | 'arch'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:forest|linen|night|mono-dark|mono-light)$/]",
        "message": "<Logo> tone must be one of 'forest' | 'linen' | 'night' | 'mono-dark' | 'mono-light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetricTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|hint|tone|key|ref|className|style|children)$/]",
        "message": "<MetricTile> doesn't accept that prop. Declared props: value, label, hint, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetricTile'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<MetricTile> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProjectFigure'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|hint|key|ref|className|style|children)$/]",
        "message": "<ProjectFigure> doesn't accept that prop. Declared props: label, value, hint."
      },
      {
        "selector": "JSXOpeningElement[name.name='RoundIcon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|tone|key|ref|className|style|children)$/]",
        "message": "<RoundIcon> doesn't accept that prop. Declared props: name, size, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='RoundIcon'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<RoundIcon> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|children|tone|key|ref|className|style|children)$/]",
        "message": "<SectionLabel> doesn't accept that prop. Declared props: index, children, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionLabel'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|light)$/]",
        "message": "<SectionLabel> tone must be one of 'default' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|options|value|placeholder|onChange|tone|name|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: label, options, value, placeholder, onChange, tone, name."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<Select> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:n|icon|title|text|tone|active|key|ref|className|style|children)$/]",
        "message": "<StepItem> doesn't accept that prop. Declared props: n, icon, title, text, tone, active."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepItem'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<StepItem> tone must be one of 'light' | 'dark'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
